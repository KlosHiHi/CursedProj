<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AndesiteAvaloniaApp.App"
             xmlns:local="using:AndesiteAvaloniaApp"
             RequestedThemeVariant="Default">
	
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
	
	<Application.Styles>
		<FluentTheme />

        <StyleInclude Source="avares://AndesiteAvaloniaApp/Assets/Styles/Themes.axaml"/>		
        <StyleInclude Source="avares://AndesiteAvaloniaApp/Assets/Styles/Styles.axaml"/>

	</Application.Styles>
</Application>