<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:AndesiteAvaloniaApp.ViewModels"
             x:DataType="vm:LoginViewModel"
             xmlns:help="using:AndesiteAvaloniaApp.Helpers"
             x:Class="AndesiteAvaloniaApp.Views.LoginView">
	
    <Design.DataContext>
		<vm:LoginViewModel/>
    </Design.DataContext>

    <DockPanel>
		
        <Border Classes="standart" DockPanel.Dock="Bottom" HorizontalAlignment="Right">
            <Border.ContextFlyout>
                <Flyout Placement="Top">
			        <TextBlock Text="Сообщение с информацией"/>
                </Flyout>
            </Border.ContextFlyout>
		    <help:SvgImage Source="avares://AndesiteAvaloniaApp/Assets/Icons/info.svg" Width="30" Height="30"/>
        </Border>
		
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Bottom">           
            <Image Source="avares://AndesiteAvaloniaApp/Assets/Icons/andesite-start.png" Width="300" Height="300" Margin="10"/>            
		    <Button Classes="login" Content="Локальная база"/>
			<Button Classes="login" Content="Войти"/>
		    <HyperlinkButton HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" Content="Создание аккаунта"/>
        </StackPanel>
		
    </DockPanel>

</UserControl>
