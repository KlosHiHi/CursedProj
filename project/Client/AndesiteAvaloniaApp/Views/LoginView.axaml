<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:AndesiteAvaloniaApp.ViewModels"
             x:DataType="vm:LoginViewModel"
             xmlns:help="using:AndesiteAvaloniaApp.Helpers"
             x:Class="AndesiteAvaloniaApp.Views.LoginView">
	
    <Design.DataContext>
		<vm:LoginViewModel/>
    </Design.DataContext>

    <DockPanel>

        <Border Classes="standart" DockPanel.Dock="Bottom" HorizontalAlignment="Right">
			
			<ToolTip.Placement>
				<PlacementMode>Left</PlacementMode>
			</ToolTip.Placement>
			
			<ToolTip.Tip>
				<TextBlock Text="Локальная база - хранится на вашем устройстве. Для синхронизации требуется войти в аккаунт."/>
			</ToolTip.Tip>	
			
		    <help:SvgImage Source="avares://AndesiteAvaloniaApp/Assets/Icons/info.svg" Width="30" Height="30"/>
        </Border>
		
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Bottom">
            <Image Source="avares://AndesiteAvaloniaApp/Assets/Icons/andesite-start.png" Width="300" Height="300" Margin="10"/>
			
		    <Button Name="CreateLocal" Classes="login" Content="Локальная база" 
					Command="{Binding OpenWindowCommand}" CommandParameter="{Binding $self.Name}"/>
			
			<Button Name="SignIn" Classes="login" Content="Войти" 
					Command="{Binding OpenWindowCommand}" CommandParameter="{Binding $self.Name}"/>

			<HyperlinkButton Name="Register" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" Content="Создание аккаунта"
							 Command="{Binding OpenWindowCommand}" CommandParameter="{Binding $self.Name}"/>
		</StackPanel>
		
    </DockPanel>
</UserControl>
