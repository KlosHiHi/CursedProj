<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		MinWidth="500" MinHeight="300"
		MaxWidth="500" MaxHeight="300"
		Title="Вход"
		Icon="avares://AndesiteAvaloniaApp/Assets/Icons/andesite.ico"
        xmlns:vm="using:AndesiteAvaloniaApp.ViewModels"
		x:DataType="vm:SignInWindowViewModel"
        x:Class="AndesiteAvaloniaApp.Views.SignInWindow">

	<Design.DataContext>
		<vm:SignInWindowViewModel/>
	</Design.DataContext>

	<DockPanel>
		<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Bottom">
			
			<StackPanel Orientation="Horizontal">
				<TextBlock Classes="login" Text="Логин"/>
				<TextBox Classes="login" Watermark="Введите логин..."/>
			</StackPanel>
			
			<StackPanel Orientation="Horizontal">
				<TextBlock Classes="login" Text="Пароль"/>
				<TextBox Classes="login" Watermark="Введите пароль..."/>
			</StackPanel>
			
			<Button Classes="login" Content="Войти"/>
			
		</StackPanel>
	</DockPanel>
	
</Window>
