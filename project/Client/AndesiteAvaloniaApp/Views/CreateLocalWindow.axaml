<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		MinWidth="500" MinHeight="300"
		MaxWidth="500" MaxHeight="300"
        xmlns:vm="using:AndesiteAvaloniaApp.ViewModels"
		x:DataType="vm:CreateLocalWindowViewModel"
		Title="Создание локальной базы"
		Icon="avares://AndesiteAvaloniaApp/Assets/Icons/andesite.ico"
        x:Class="AndesiteAvaloniaApp.Views.CreateLocalWindow"
		Name="Window">

	<Design.DataContext>
		<vm:CreateLocalWindowViewModel/>
	</Design.DataContext>

	<DockPanel>
		<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" DockPanel.Dock="Bottom">

			<StackPanel Orientation="Horizontal">
				<TextBlock Classes="login" Text="Название"/>
				<TextBox Classes="login" PlaceholderText="Введите название базы"  Text="{Binding LocalName}"/>
			</StackPanel>

			<Button Classes="login" Content="Создать" Command="{Binding CreateLocalCommand}" CommandParameter="{Binding #Window}"/>

		</StackPanel>
	</DockPanel>
	
</Window>
