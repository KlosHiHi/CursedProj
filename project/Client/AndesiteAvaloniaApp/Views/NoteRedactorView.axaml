<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AndesiteAvaloniaApp.Views.NoteRedactorView"             
             xmlns:vm="using:AndesiteAvaloniaApp.ViewModels"
             x:DataType="vm:NoteRedactorViewModel"
			 xmlns:i="using:Avalonia.Xaml.Interactivity"
			 xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
             >
    <Design.DataContext>
		<vm:NoteRedactorViewModel/>
	</Design.DataContext>

	<i:Interaction.Behaviors>
		<ia:EventTriggerBehavior EventName="Loaded">
			<ia:InvokeCommandAction Command="{Binding OpenEditorCommand}" CommandParameter="{Binding #EditorWebView}"/>
		</ia:EventTriggerBehavior>
	</i:Interaction.Behaviors>

    <Grid>
        <NativeWebView x:Name="EditorWebView"/>
    </Grid>
</UserControl>