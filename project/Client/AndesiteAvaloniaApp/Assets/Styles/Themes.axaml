<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Light">

                    <SolidColorBrush x:Key="AppBackground" Color="#f5fafb"/>

                    <SolidColorBrush x:Key="Surface" Color="#e3e9ea"/>
					
                    <SolidColorBrush x:Key="SurfaceHigh" Color="#dee4e4"/>

                    <SolidColorBrush x:Key="TextPrimary" Color="#000000"/>

                    <SolidColorBrush x:Key="Border" Color="#FFFFFF"/>

                    <SolidColorBrush x:Key="Accent" Color="#006971"/>
					
                    <SolidColorBrush x:Key="SecondAccent" Color="#deba52"/>
                    
                    <SolidColorBrush x:Key="Secondary" Color="#b1cbcf"/>
					
                    <SolidColorBrush x:Key="Error" Color="#ba1a1a"/>
					
                    <SolidColorBrush x:Key="Black" Color="#000000"/>
					
                    <SolidColorBrush x:Key="White" Color="#FFFFFF"/>

                    <SolidColorBrush x:Key="Grey" Color="#808080"/>

                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">

                    <SolidColorBrush x:Key="AppBackground" Color="#0e1415"/>

                    <SolidColorBrush x:Key="Surface" Color="#252b2c"/>

                    <SolidColorBrush x:Key="SurfaceHigh" Color="#303637"/>

                    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>

                    <SolidColorBrush x:Key="Border" Color="#000000"/>

                    <SolidColorBrush x:Key="Accent" Color="#81d3dd"/>

                    <SolidColorBrush x:Key="SecondAccent" Color="#deba52"/>

                    <SolidColorBrush x:Key="Secondary" Color="#b1cbcf"/>
					
					<SolidColorBrush x:Key="Error" Color="#ffb4ab"/>
					
					<SolidColorBrush x:Key="Black" Color="#000000"/>
					
					<SolidColorBrush x:Key="White" Color="#FFFFFF"/>

                    <SolidColorBrush x:Key="Grey" Color="#808080"/>

                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>