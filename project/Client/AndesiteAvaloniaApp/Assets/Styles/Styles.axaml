<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:AndesiteAvaloniaApp.Helpers">

	<Style Selector="Window">
		<Setter Property="Background" Value="{DynamicResource AppBackground}"/>
	</Style>
	
	<Style Selector="StackPanel.menu_button">
		<Setter Property="Orientation" Value="Horizontal"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Margin" Value="5"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>

	<Style Selector="StackPanel.menu_button:pointerover">
		<Setter Property="Opacity" Value="0.6"/>
	</Style>

	<Style Selector="Border.menu_part">
		<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
		<Setter Property="BorderThickness" Value="2"/>
		<Setter Property="Margin" Value="0"/>
		<Setter Property="Padding" Value="0"/>
	</Style>

	<Style Selector="StackPanel.menu_button TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource Accent}"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="FontSize" Value="20"/>
		<Setter Property="Margin" Value="3"/>
		<Setter Property="Width" Value="300"/>
		<Setter Property="FontWeight" Value="Bold"/>
	</Style>

	<Style Selector="StackPanel.menu_button helpers|SvgImage">
		<Setter Property="Width" Value="50"/>
		<Setter Property="Height" Value="50"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style Selector="TextBlock">
		<Setter Property="FontFamily" Value="#Roboto"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>
	
	<Style Selector="TextBlock.login">
		<Setter Property="Foreground" Value="{DynamicResource Accent}"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="FontSize" Value="15"/>
		<Setter Property="Width" Value="90"/>
		<Setter Property="Margin" Value="3"/>
	</Style>

	<Style Selector="Button">
		<Setter Property="FontFamily" Value="#Roboto"/>
		<Setter Property="FontSize" Value="16"/>
	</Style>

	<Style Selector="Button.burger">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Margin" Value="5"/>
	</Style>

	<Style Selector="Button.burger:pointerover /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
	</Style>

	<Style Selector="Button.burger:pressed /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="Opacity" Value="1"/>
	</Style>

	<Style Selector="Button.login">
		<Setter Property="Background" Value="{DynamicResource Accent}"/>
		<Setter Property="Foreground" Value="{DynamicResource AppBackground}"/>
		<Setter Property="Width" Value="350"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="Margin" Value="5"/>
	</Style>

	<Style Selector="Border.standart">
		<Setter Property="Background" Value="{DynamicResource Surface}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
		<Setter Property="BorderThickness" Value="2"/>
		<Setter Property="CornerRadius" Value="10"/>
		<Setter Property="Margin" Value="3"/>
	</Style>	

	<Style Selector="TextBox">
		<Setter Property="FontFamily" Value="#Roboto"/>
		<Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
	</Style>

	<Style Selector="TextBox.login">
		<Setter Property="Background" Value="{DynamicResource White}"/>
		<Setter Property="Foreground" Value="{DynamicResource Black}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
		<Setter Property="PlaceholderForeground" Value="{DynamicResource Grey}"/>
		<Setter Property="Margin" Value="3"/>
		<Setter Property="Width" Value="260"/>
	</Style>

	<Style Selector="TextBox.login:focus /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="{DynamicResource Secondary}" />
	</Style>

	<Style Selector="TextBox.login:pointerover /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="{DynamicResource Secondary}" />
	</Style>
	
</Styles>